{
  "appId": "{{PACKAGE_ID}}",
  "appName": "وعد",
  "webDir": "www",
  "server": {
    "url": "https://{{DOMAIN}}{{APP_PATH}}?src=app",
    "cleartext": false,
    "allowNavigation": [
      "{{DOMAIN}}",
      "*.supabase.co"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#131B2E",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#131B2E"
    }
  }
}